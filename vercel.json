{
  "outputDirectory": "dist",
  "buildCommand": "vite build",
  "devCommand": "vite",
  "rewrites": [{"source": "/(.*)", "destination": "/index.html"}],
  "firestore": {
    "rules": "firestore.rules"
  },
  "crons": [
    {
      "path": "/api/cron-dld-daily",
      "schedule": "0 3 * * *"
    }
  ]
}