#!/bin/sh
# DXB Analytics — Pre-commit Safety Guard
# Blocks commits that would introduce known problems

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

ERRORS=0
WARNINGS=0

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  DXB Analytics — Pre-Commit Safety Check"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# ── CHECK 1: Hardcoded API Keys / Secrets ──────────────────────────────
echo "🔐 Checking for hardcoded secrets..."

STAGED=$(git diff --cached --name-only)

SECRET_PATTERNS=(
  "AIzaSy"
  "firebase-adminsdk"
  "420de140camsh"
  "re_FGZe2ET2"
  "USkwUhp0cs"
  "sk_live_"
  "sk_test_"
  "rk_live_"
  "AKIA"
  "dxb-cron-2026"
  "service_da7nshv"
  "template_gl1xqhy"
  "mianwaleed689@gmail"
)

for file in $STAGED; do
  if [ -f "$file" ]; then
    # Skip the hook files themselves
    case "$file" in
      .githooks/*|.git/hooks/*) continue ;;
    esac
    for pattern in "${SECRET_PATTERNS[@]}"; do
      if git diff --cached "$file" | grep "^+" | grep -q "$pattern"; then
        echo ""
        echo "  ❌ BLOCKED — Hardcoded secret detected!"
        echo "  📄 File: $file"
        echo "  🔑 Pattern: $pattern"
        echo "  ⚠️  This will expose credentials to anyone with GitHub access."
        echo "  ✅ Fix: Use process.env.YOUR_VAR_NAME instead."
        echo "         Add the real value to Vercel environment variables."
        ERRORS=$((ERRORS + 1))
      fi
    done
  fi
done

# ── CHECK 2: Credential/Key JSON Files ─────────────────────────────────
echo "🔑 Checking for credential files..."

for file in $STAGED; do
  case "$file" in
    *adminsdk*.json|serviceAccount*.json|serviceAccountKey*.json|*firebase*key*.json)
      echo ""
      echo "  ❌ BLOCKED — Firebase credential file detected!"
      echo "  📄 File: $file"
      echo "  ⚠️  This is a private key that gives admin access to your entire Firebase project."
      echo "  ✅ Fix: Delete this file from the repo. Add *.json to .gitignore for key files."
      echo "         Store Firebase credentials in Vercel environment variables only."
      ERRORS=$((ERRORS + 1))
      ;;
    .env|.env.local|.env.production|.env.*)
      echo ""
      echo "  ❌ BLOCKED — Environment file detected!"
      echo "  📄 File: $file"
      echo "  ⚠️  .env files contain secrets and must NEVER be committed."
      echo "  ✅ Fix: Add .env* to .gitignore immediately."
      ERRORS=$((ERRORS + 1))
      ;;
  esac
done

# ── CHECK 3: Files That Should Not Be in src/ ──────────────────────────
echo "📁 Checking for non-code files in src/..."

for file in $STAGED; do
  case "$file" in
    src/*.docx|src/*.pdf|src/*.xlsx|src/*.doc|src/*.pptx)
      echo ""
      echo "  ❌ BLOCKED — Document file in src/ folder!"
      echo "  📄 File: $file"
      echo "  ⚠️  src/ is for source code only. Documents do not belong here."
      echo "  ✅ Fix: Move to /docs/planning/ or /docs/research/ and add to .gitignore."
      ERRORS=$((ERRORS + 1))
      ;;
    src/*.bak|src/*.tmp|src/*.orig)
      echo ""
      echo "  ❌ BLOCKED — Backup/temp file in src/!"
      echo "  📄 File: $file"
      echo "  ⚠️  Backup files should never be committed."
      echo "  ✅ Fix: Delete this file. Use git branches for version control instead."
      ERRORS=$((ERRORS + 1))
      ;;
    src/*_original*|src/*_backup*|src/*_old*)
      echo ""
      echo "  ❌ BLOCKED — Backup copy of source file detected!"
      echo "  📄 File: $file"
      echo "  ⚠️  Never keep _original, _backup, or _old copies of files."
      echo "  ✅ Fix: Delete it. Use git history to recover old versions: git log --follow $file"
      ERRORS=$((ERRORS + 1))
      ;;
  esac
done

# ── CHECK 4: Script Files in Root Directory ─────────────────────────────
echo "🗂️  Checking for loose scripts in root..."

for file in $STAGED; do
  # Check if it's a .py or debug .js file in root (not in a subfolder)
  filename=$(basename "$file")
  dirname=$(dirname "$file")
  
  if [ "$dirname" = "." ]; then
    case "$file" in
      fix*.py|check*.py|fix*.js|check*.js|seed-*.js|import_*.js|migrate*.js|step*.py|restore.py|cleanup.py|revert*.py)
        echo ""
        echo "  ❌ BLOCKED — Debug/utility script in root directory!"
        echo "  📄 File: $file"
        echo "  ⚠️  The project root is not a scratch pad. Loose scripts make the codebase look unprofessional."
        echo "  ✅ Fix: Move to scripts/legacy/ or scripts/utils/ folder."
        echo "         Or delete it if no longer needed."
        ERRORS=$((ERRORS + 1))
        ;;
    esac
  fi
done

# ── CHECK 5: File Size Warning ──────────────────────────────────────────
echo "📏 Checking file sizes..."

for file in $STAGED; do
  if [ -f "$file" ]; then
    case "$file" in
      *.jsx|*.tsx|*.js|*.ts)
        lines=$(wc -l < "$file" 2>/dev/null || echo 0)
        if [ "$lines" -gt 1000 ]; then
          echo ""
          echo "  ⚠️  WARNING — Very large file detected!"
          echo "  📄 File: $file ($lines lines)"
          echo "  ⚠️  Files over 1000 lines are hard to maintain and review."
          echo "  💡 Consider splitting into smaller components."
          echo "     Each tab/feature should be in its own file (target: under 500 lines)."
          WARNINGS=$((WARNINGS + 1))
        fi
        ;;
    esac
  fi
done

# ── CHECK 6: ESM vs CommonJS in API files ──────────────────────────────
echo "🔧 Checking module syntax in API files..."

for file in $STAGED; do
  case "$file" in
    api/*.js)
      if git diff --cached "$file" | grep "^+" | grep -q "^export default"; then
        echo ""
        echo "  ❌ BLOCKED — ESM syntax in Vercel API file!"
        echo "  📄 File: $file"
        echo "  ⚠️  Vercel serverless functions must use CommonJS, not ESM."
        echo "  ✅ Fix: Change 'export default async function handler' to 'module.exports = async (req, res) =>'"
        ERRORS=$((ERRORS + 1))
      fi
      ;;
  esac
done

# ── CHECK 7: console.log with sensitive data ────────────────────────────
echo "🔍 Checking for sensitive data in logs..."

for file in $STAGED; do
  if [ -f "$file" ]; then
    case "$file" in
      *.js|*.jsx|*.ts|*.tsx)
        if git diff --cached "$file" | grep "^+" | grep -qi "console.log.*password\|console.log.*secret\|console.log.*apikey\|console.log.*token"; then
          echo ""
          echo "  ⚠️  WARNING — Possible sensitive data in console.log!"
          echo "  📄 File: $file"
          echo "  ⚠️  Never log passwords, tokens, or API keys."
          WARNINGS=$((WARNINGS + 1))
        fi
        ;;
    esac
  fi
done

# ── SUMMARY ────────────────────────────────────────────────────────────
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ $ERRORS -gt 0 ]; then
  echo "  ❌ COMMIT BLOCKED — $ERRORS error(s) found"
  echo ""
  echo "  Fix the issues above and try again."
  echo "  To skip this check (DANGEROUS): git commit --no-verify"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  exit 1
fi

if [ $WARNINGS -gt 0 ]; then
  echo "  ⚠️  $WARNINGS warning(s) — commit allowed but please review above"
else
  echo "  ✅ All checks passed — commit allowed"
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
exit 0
