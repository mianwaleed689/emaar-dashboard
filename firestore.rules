rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──────────────────────────────────────────────────
    function isAuthed() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    /* Admin identity is recorded inconsistently in this database: most accounts
       use a `role` string, but at least one carries a boolean `superAdmin` field
       instead. A rule that only checked `role` would silently deny a genuine
       admin — which is exactly what happened when the /organisations read was
       tightened. Both shapes are accepted, and every map access is guarded with
       `in` because reading a missing key errors, and an errored condition denies
       the whole request. */
    function isSuperAdmin() {
      return isAuthed() && (
        ('role' in getUserData() && getUserData().role == 'superAdmin') ||
        ('superAdmin' in getUserData() && getUserData().superAdmin == true)
      );
    }
    function isAdmin() {
      return isSuperAdmin() ||
        (isAuthed() && 'role' in getUserData() && getUserData().role == 'admin');
    }
    /* WHO MAY MANAGE AN AGENCY'S DATA.
       This was `orgRole == 'manager' || isAdmin()`. The words 'owner' and
       'director' did not appear anywhere in this file, while the application
       defines five roles — superAdmin, owner, director, manager, agent — and
       sixteen rules gate on this one function.

       The effect: an agency OWNER could not read or write their own deals,
       listings or team records. The Pipeline tab told them "contact your agency
       manager to access the deal pipeline", and even had they got past that, the
       database would have refused them. The person who buys the software was the
       one person locked out of it.

       Owner and director sit ABOVE manager in the app's own hierarchy, so both
       are included here. Tenant isolation is unaffected: every caller still has
       to pass isSameOrg() separately, so this widens who inside an agency may
       act, never which agency's data they can reach. */
    function isManager() {
      return isAuthed() && (
        getUserData().orgRole == 'owner'   ||
        getUserData().orgRole == 'director'||
        getUserData().orgRole == 'manager' ||
        isAdmin()
      );
    }
    function isAgent() {
      return isAuthed() && getUserData().orgRole == 'agent';
    }
    /* WHO MAY SET ANOTHER PERSON'S DEPARTMENT AND SENIORITY.
       Narrower than isManager() on purpose. Department and seniority DECIDE
       what somebody can see — moving a person into Management or Accounts hands
       them the whole agency's money — so a sales manager must not be able to do
       it. Owner, director and platform admin only. */
    function isOrgAdmin() {
      return isAuthed() && (
        getUserData().orgRole == 'owner' ||
        getUserData().orgRole == 'director' ||
        isAdmin()
      );
    }
    function userOrgId() { return getUserData().orgId; }
    function isSameOrg(orgId) { return isAuthed() && userOrgId() == orgId; }
    function isAssignedAgent(assignedTo) { return isAuthed() && uid() == assignedTo; }
    /* THE THIRD TIME THIS EXACT OMISSION HAS SURFACED.
       'owner' and 'director' were missing from this list, so the two most
       senior people in an agency did not "have CRM" and could not create a
       lead, a deal or a viewing. The same words were missing from isManager(),
       which locked an owner out of their own pipeline, and from the tab gates
       written as `orgRole === "manager"`, which told them "Manager access
       only". Found this time by seeding a demo agency: the founder could build
       the company and then could not give it a single lead.

       An agency owner has the CRM by definition. They bought it. */
    function hasCRM() {
      return isAuthed() && (
        ('orgRole' in getUserData() &&
          getUserData().orgRole in ['owner', 'director', 'manager', 'agent']) ||
        ('role' in getUserData() &&
          getUserData().role in ['manager', 'agent']) ||
        ('crmPlan' in getUserData() &&
          getUserData().crmPlan in ['crm_free', 'crm_pro', 'crm_enterprise']) ||
        ('tier' in getUserData() &&
          getUserData().tier in ['pro', 'enterprise', 'pro_trial']) ||
        isAdmin()
      );
    }

    // ── USERS ────────────────────────────────────────────────────
    // Fields that decide privilege, billing tier or verification status.
    // A user must never be able to set these on themselves — isAdmin() reads
    // role from this very document, so a self-write would be self-promotion.
    function privilegedUserFields() {
      return [
        'role', 'orgRole', 'orgId', 'tier', 'crmPlan',
        /* department and seniority decide what a person can SEE, so they are
           privilege in everything but name. A user changing their own
           department to 'management' would hand themselves the agency's
           revenue, so they are frozen for the owner of the record exactly as
           orgRole is. */
        'department', 'seniority', 'managerId',
        /* Pay. Without these here a user could set their own basic salary and
           allowances, because the self-update clause below permits anything
           not named in this list — and payroll computes from exactly these
           fields. Only an org admin or a platform admin may write them. */
        'basic', 'allowances', 'salary', 'deductions',
        'trialStart', 'trialEnd', 'subscriptionStatus',
        'verified', 'verifiedLevel', 'verifiedAt', 'kycLevel', 'suspended'
      ];
    }

    match /users/{userId} {
      /* `resource.data`, not `get()` on the very document being read.
         The get() form worked for fetching one person and failed for LISTING
         them, which is what the Team roster does — so an agency owner opening
         Team saw "0 agents" and a console warning, while the agents existed and
         could log in perfectly well. Verified in a browser: the roster came
         back "Missing or insufficient permissions".

         Document-access calls inside rules are also capped per request, so a
         get() per row puts a ceiling on how many people an agency could ever
         list. resource.data is the document being evaluated — no fetch, no cap,
         and it is the same condition. */
      allow read: if isAuthed() && (
        uid() == userId ||
        isSuperAdmin() ||
        (isManager() && resource.data.orgId == userOrgId())
      );

      // Sign-up: own document only. Self-serve signup legitimately sets role and
      // tier, so those are allowed but constrained to safe values.
      allow create: if isAuthed() && uid() == userId
        && (!('role' in request.resource.data) || request.resource.data.role in ['user', 'developer'])
        && (!('tier' in request.resource.data) || request.resource.data.tier in ['free', 'pro_trial'])
        && !request.resource.data.keys().hasAny([
             'crmPlan', 'subscriptionStatus', 'verified', 'verifiedLevel', 'kycLevel', 'suspended'
           ]);

      /* AN AGENCY OWNER CREATES THEIR OWN STAFF.
         Only self-creation was allowed here, which looked safe and was — but
         it meant a manager adding an agent could not write that agent's user
         document. The Team tab got away with it for the worst possible reason:
         it created the auth account on the primary Firebase app, which SIGNED
         THE NEW AGENT IN, so the write ran as the agent writing their own
         document and passed. The bug was holding the feature up. Fixing the
         session theft in TeamTab.jsx made this denial visible, verified in a
         browser as "Missing or insufficient permissions".

         The same guards as the update clause below: an org admin, the new
         person must land in the creator's OWN agency, no minting of admins,
         and none of the billing or verification fields. */
      allow create: if isOrgAdmin()
        && request.resource.data.orgId == userOrgId()
        && (!('role' in request.resource.data) || request.resource.data.role in ['user', 'agent'])
        && (!('orgRole' in request.resource.data)
            || request.resource.data.orgRole in ['owner', 'director', 'manager', 'agent'])
        && (!('tier' in request.resource.data) || request.resource.data.tier in ['free', 'pro_trial'])
        && !request.resource.data.keys().hasAny([
             'crmPlan', 'subscriptionStatus', 'verified', 'verifiedLevel', 'kycLevel', 'suspended'
           ]);

      // After sign-up the privileged fields are frozen for the owner.
      // Admins may still manage users, but only a superAdmin can mint a superAdmin.
      allow update: if isAuthed() && (
        isSuperAdmin() ||
        // Null-safe: a user document with no 'role' field must not make this
        // clause error out (an errored condition denies the whole write).
        (isAdmin() && (!('role' in request.resource.data)
                       || request.resource.data.role != 'superAdmin')) ||
        /* An agency owner or director manages their own people — setting a
           department, a reporting line, a broker card, a joining date. Before
           this, only a platform admin could, so an agency could not record its
           own staff and everybody stayed an "agent". They may not mint an admin
           and may not move somebody into another agency. */
        (isOrgAdmin()
          && resource.data.orgId == userOrgId()
          && (!('role' in request.resource.data)
              || request.resource.data.role in ['user', 'agent', 'manager', 'developer'])
          && (!('orgId' in request.resource.data)
              || request.resource.data.orgId == resource.data.orgId)) ||
        /* AN INDIVIDUAL FOUNDS THEIR OWN AGENCY.
           orgId, orgRole, department and seniority are privileged, and rightly
           so — a user setting their own department to 'management' would hand
           themselves the agency's revenue. But that freeze also meant a solo
           agent could NEVER become an agency: they had signed up through the
           individual door, had no orgId, and nothing in the product could give
           them one. Their only escape was abandoning the account and signing
           up again on another email, because Firebase will not reuse the first.

           This clause opens exactly that one path and nothing wider:
             · they must currently belong to NO agency, so it cannot be used to
               defect from one agency to another, or to promote yourself inside
               the one you are already in;
             · the organisation must already exist and record them as its
               ownerId, so nobody can attach themselves to somebody else's;
             · they become an owner of it — not a role of their choosing;
             · and only those four fields may move. Not role, not tier, not
               anything that decides what they have paid for. */
        (uid() == userId
          && (!('orgId' in resource.data) || resource.data.orgId == null
              || resource.data.orgId == '')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['orgId', 'orgRole', 'department', 'seniority', 'updatedAt'])
          && request.resource.data.orgRole == 'owner'
          && request.resource.data.department == 'management'
          && request.resource.data.seniority == 'owner'
          && exists(/databases/$(database)/documents/organisations/$(request.resource.data.orgId))
          && get(/databases/$(database)/documents/organisations/$(request.resource.data.orgId))
               .data.ownerId == uid()) ||
        (uid() == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedUserFields()))
      );

      allow delete: if isSuperAdmin();
    }

    /* COMMISSION SPLITS — what each agent takes of a deal.
       These used to be a map on the organisation document, so any member who
       could read the organisation could read what every colleague is paid;
       rules cannot restrict one field of a document. One document per agent
       makes the restriction expressible: the agency's managers see all of
       them, and an agent sees their own and nobody else's. */
    /* MARKETING SPEND — what each channel cost.
       Read by anybody in the agency, because cost per deal is a company figure
       and the screen shows no client records. Written by an org admin only: it
       decides which channels look worth renewing. */
    match /organisations/{orgId}/marketingSpend/{source} {
      allow read:  if isAuthed() && (isAdmin() || userOrgId() == orgId);
      allow write: if isAuthed() && (isSuperAdmin() ||
                                     (isOrgAdmin() && userOrgId() == orgId));
    }

    match /organisations/{orgId}/commissionSplits/{agentId} {
      allow read:  if isAuthed() && (isAdmin() || uid() == agentId ||
                                     (isManager() && userOrgId() == orgId));
      allow write: if isAuthed() && (isSuperAdmin() ||
                                     (isOrgAdmin() && userOrgId() == orgId));
    }

    // ── ORGANISATIONS ─────────────────────────────────────────────
    match /organisations/{orgId} {
      /* This was left open — any signed-in user could read EVERY organisation
         on the platform. In a product sold to thousands of separate agencies
         that is every competitor's company record, plan and settings.

         It was left open for a reason that no longer holds: tightening it once
         caused a permission-denied in PlatformLeadsTab, and the note here
         guessed correctly that the cause was the admin account carrying a
         boolean `superAdmin` field rather than a `role` string. isSuperAdmin()
         now accepts both shapes, so the original blocker is gone and this can
         close.

         An agency reads its own record; an admin reads any. Create stays open
         because self-serve signup creates the organisation before the user has
         one to be scoped to. */
      allow read: if isAuthed() && (isAdmin() || userOrgId() == orgId);
      allow create: if isAuthed();
      allow update: if isAuthed() && (isSuperAdmin() || (isManager() && userOrgId() == orgId));
      allow delete: if isSuperAdmin();

      // Members subcollection
      match /members/{memberId} {
        allow read: if isAuthed() && (isSuperAdmin() || userOrgId() == orgId);
        allow write: if isAuthed() && (isSuperAdmin() || (isManager() && userOrgId() == orgId));
      }

      // Invitations subcollection
      match /invitations/{inviteId} {
        allow read: if isAuthed() && (isSuperAdmin() || userOrgId() == orgId);
        allow create: if isAuthed() && (isSuperAdmin() || (isManager() && userOrgId() == orgId));
        allow update: if isAuthed();
        allow delete: if isAuthed() && (isSuperAdmin() || (isManager() && userOrgId() == orgId));
      }
    }

    // ── LEADS ─────────────────────────────────────────────────────
    match /leads/{leadId} {
      allow read: if isAuthed() && hasCRM() && (
        isSuperAdmin() ||
        (isManager() && isSameOrg(resource.data.orgId)) ||
        isAssignedAgent(resource.data.assignedTo) ||
        resource.data.createdBy == uid()
      );
      allow create: if isAuthed() && hasCRM() && (
        isSuperAdmin() || isSameOrg(request.resource.data.orgId)
      );
      allow update: if isAuthed() && hasCRM() && (
        isSuperAdmin() ||
        (isManager() && isSameOrg(resource.data.orgId)) ||
        isAssignedAgent(resource.data.assignedTo)
      );
      allow delete: if isAuthed() && (
        isSuperAdmin() ||
        (isManager() && isSameOrg(resource.data.orgId))
      );

      // Lead activity log subcollection
      match /activity/{activityId} {
        allow read: if isAuthed() && hasCRM() && (
          isSuperAdmin() ||
          (isManager() && isSameOrg(get(/databases/$(database)/documents/leads/$(leadId)).data.orgId)) ||
          isAssignedAgent(get(/databases/$(database)/documents/leads/$(leadId)).data.assignedTo)
        );
        allow create: if isAuthed() && hasCRM();
        allow update, delete: if isSuperAdmin();
      }
    }

    // ── DEALS ────────────────────────────────────────────────────
    /* DEALS.
       Two faults made this collection unusable, on top of the owner lockout
       fixed in isManager() above.

       1. CREATE WAS IMPOSSIBLE. A single `allow write` gated on
          `resource.data.orgId`. On a create the document does not exist yet, so
          `resource` is null, reading `.data.orgId` errors, and an errored
          condition denies the whole request. Nobody below superAdmin could ever
          create a deal. Create is split out and reads request.resource.data,
          which is the incoming document — the same shape /leads already uses.

       2. THE OWNERSHIP FIELD WAS WRONG. The rule checked `assignedTo`; every
          write path in the app sets `agentId`. So `assignedTo` was always
          undefined and an agent could not touch their own deal. Both fields are
          accepted, because older records may carry either.

       Tenant isolation is unchanged and still mandatory: orgId must match on
       create, and cannot be changed on update. */
    match /deals/{dealId} {
      function ownsDeal() {
        return isAssignedAgent(resource.data.assignedTo) ||
               ('agentId' in resource.data && resource.data.agentId == uid());
      }

      allow read: if isAuthed() && (
        isSuperAdmin() ||
        (isManager() && isSameOrg(resource.data.orgId)) ||
        ownsDeal()
      );

      allow create: if isAuthed() && hasCRM() && (
        isSuperAdmin() || isSameOrg(request.resource.data.orgId)
      );

      allow update: if isAuthed() && (
        isSuperAdmin() ||
        (isManager() && isSameOrg(resource.data.orgId)) ||
        ownsDeal()
      /* A deal may never be moved into another agency. */
      ) && (isSuperAdmin() || request.resource.data.orgId == resource.data.orgId);

      allow delete: if isAuthed() && (
        isSuperAdmin() || (isManager() && isSameOrg(resource.data.orgId))
      );
    }

    /* VIEWINGS.
       An agent's week. Scoped to the agency, and an agent may only create or
       change their own — a viewing is a record of where somebody physically
       was, so it should not be editable by a colleague. Managers and above may
       reassign or correct one, because cover is a real thing. */
    match /viewings/{viewingId} {
      /* An agent's own viewing is theirs, without an organisation lookup.
         The agent's listener queries `where agentId == me`, but the only read
         condition was isSameOrg(), which resolves the reader's orgId through a
         document fetch — so the subscription came back permission-denied at
         least once per session, and onSnapshot does not retry a refused
         subscription. Owning the record is the simpler and truer condition, and
         it matches the query the app actually makes. */
      allow read: if isAuthed() && (
        isSuperAdmin() ||
        ('agentId' in resource.data && resource.data.agentId == uid()) ||
        isSameOrg(resource.data.orgId)
      );
      allow create: if isAuthed() && (
        isSuperAdmin() || isSameOrg(request.resource.data.orgId)
      );
      allow update: if isAuthed() && (
        isSuperAdmin() ||
        (isManager() && isSameOrg(resource.data.orgId)) ||
        ('agentId' in resource.data && resource.data.agentId == uid())
      ) && (isSuperAdmin() || request.resource.data.orgId == resource.data.orgId);
      allow delete: if isAuthed() && (
        isSuperAdmin() || (isManager() && isSameOrg(resource.data.orgId))
      );
    }

    // ── LISTINGS ─────────────────────────────────────────────────
    /* LISTINGS. Same create fault as /deals: a single `allow write` gated on
       `resource.data`, which is null before the document exists, so nobody
       below superAdmin could create a listing. Create is split out and reads
       request.resource.data. A listing may never be moved to another agency. */
    match /listings/{listingId} {
      allow read: if isAuthed() && (isSuperAdmin() || isSameOrg(resource.data.orgId));

      allow create: if isAuthed() && (
        isSuperAdmin() || isSameOrg(request.resource.data.orgId)
      );

      allow update: if isAuthed() && (
        isSuperAdmin() ||
        (isManager() && isSameOrg(resource.data.orgId)) ||
        ('agentId' in resource.data && resource.data.agentId == uid())
      ) && (isSuperAdmin() || request.resource.data.orgId == resource.data.orgId);

      allow delete: if isAuthed() && (
        isSuperAdmin() ||
        (isManager() && isSameOrg(resource.data.orgId)) ||
        ('agentId' in resource.data && resource.data.agentId == uid())
      );
    }

    // ── PORTFOLIOS ───────────────────────────────────────────────
    match /portfolios/{userId} {
      allow read, write: if isAuthed() && uid() == userId;
      allow read: if isSuperAdmin();
    }

    /* Watchlist and price alerts. Both are keyed by the user's own uid and both
       were MISSING from these rules entirely, so Firestore denied every read and
       every write. The app opens a live listener on each of them on sign-in, so
       every session logged two permission-denied errors, and saving a watchlist
       or an alert could not work at all. Same shape as portfolios above. */
    match /watchlists/{userId} {
      allow read, write: if isAuthed() && uid() == userId;
      allow read: if isSuperAdmin();
    }

    match /priceAlerts/{userId} {
      allow read, write: if isAuthed() && uid() == userId;
      allow read: if isSuperAdmin();
    }

    // ── MORTGAGE LEADS ───────────────────────────────────────────
    match /mortgageLeads/{leadId} {
      allow read: if isAuthed() && (
        isSuperAdmin() || isSameOrg(resource.data.orgId) || resource.data.userId == uid()
      );
      allow create: if isAuthed();
      allow update: if isAuthed() && (isSuperAdmin() || resource.data.userId == uid());
    }

    // ── COMPLIANCE ───────────────────────────────────────────────
    match /compliance/{doc} {
      allow read: if isAuthed() && (isSuperAdmin() || isSameOrg(resource.data.orgId));
      allow write: if isManager();
    }
    match /reraCards/{doc} {
      allow read: if isAuthed() && (isSuperAdmin() || isSameOrg(resource.data.orgId));
      allow write: if isManager();
    }

    // ── DEV EOIs ─────────────────────────────────────────────────
    match /devEOIs/{doc} {
      allow read: if isAuthed() && (isSuperAdmin() || isSameOrg(resource.data.orgId));
      allow write: if isAuthed();
    }

    // ── NOTIFICATIONS ────────────────────────────────────────────
    /* NOTIFICATIONS.
       Two faults, both serious.

       READ WAS OPEN TO EVERY SIGNED-IN USER. Not every user in the agency —
       every user of the whole platform. A notification carries the client's
       name, the deal, the amount and the reason it concerns you, so this was
       one agency reading another agency's pipeline one message at a time. It is
       also exactly what the notification model refuses to do in code: it filters
       recipients through the access model precisely so nobody is told about
       something they cannot open. The rules were undoing that.

       CREATE WAS IMPOSSIBLE FOR ANYONE ELSE. `resource.data.userId == uid()` on
       a create reads a document that does not exist yet, so the only person who
       could be sent a notification was yourself. Every "tell the next
       department" write would have been denied — the whole point of the
       workflow.

       Now: you read your own; anyone in the agency may create one FOR a
       colleague in the same agency; you may only update your own, and only to
       mark it read. */
    match /notifications/{doc} {
      allow read: if isAuthed() && (
        isSuperAdmin() ||
        resource.data.userId == uid() ||
        resource.data.userId == "all"
      );

      allow create: if isAuthed() && (
        isSuperAdmin() ||
        /* Same agency, and addressed to somebody — a notification with no
           recipient is a broadcast, and broadcasts are an admin action. */
        (isSameOrg(request.resource.data.orgId) && request.resource.data.userId is string)
      );

      allow update: if isAuthed() && (
        isSuperAdmin() || resource.data.userId == uid()
      );

      allow delete: if isAuthed() && (
        isSuperAdmin() || resource.data.userId == uid()
      );
    }

    // ── PUBLIC READ-ONLY DATA (all authenticated users) ──────────
    match /projects/{doc}         { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /liveMarketData/{doc}   { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /dldVolumes/{doc}       { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /yieldData/{doc}        { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /neighbourhoods/{doc}   { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /launches/{doc}         { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /serviceCharges/{doc}   { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /developers/{doc}       { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /developerHealth/{doc}  { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /financials/{doc}       { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /eiborRates/{doc}       { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /communityData/{doc}    { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /communities/{doc}      { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /communityROI/{doc}     { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /neighbourhoodScores/{doc} { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /communityIntel/{doc}   { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /developments/{doc}     { allow read: if isAuthed(); allow write: if isAdmin(); }

    /* ── PLATFORM-INTERNAL COLLECTIONS ────────────────────────────────────
       Everything below held `allow read: if isAuthed()`, which in a product
       sold to thousands of separate agencies means ANY signed-in user of ANY
       agency could read the WHOLE collection.

       For the Dubai market reference data above that is correct and intended —
       every agency sees the same transactions, the same developers, the same
       yields. For these it was a leak:

         referrals        held referrerEmail, referrerName and convertedEmail —
                          real customers' addresses
         supportTickets   one agency could read another agency's support
                          conversations, and the audit trail with them
         payments         every agency's payment records
         platformLeads    our own sales prospects — i.e. the contact details of
                          other agencies
         cancellations    who left and the reason they gave
         supportWebhooks  endpoint configuration, including the logs

       Reads are now admin-only. Writes already were. Nothing user-facing reads
       any of these: verified by grep — every one is referenced solely from
       src/admin/AdminPanel.jsx. */
    match /adminAlerts/{doc}      { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /cancellations/{doc}    { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /competitors/{doc}      { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /devHealth/{doc}        { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /developerClaims/{doc}  { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /digestLog/{doc}        { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /eiborHistory/{doc}     { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /handover/{doc}         { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /investScores/{doc}     { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /mortgageRates/{doc}    { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /notificationTemplates/{doc} { allow read: if isAdmin(); allow write: if isAdmin(); }
    // NOTE: /organisations is deliberately NOT re-declared here. It has its own
    // org-scoped block above. Firestore ORs all matching rules together, so a
    // blanket "read: if isAuthed()" on this path would silently cancel that
    // scoping and let every signed-in user read every organisation.
    match /payments/{doc}         { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /platformLeads/{doc}    { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /projectData/{doc}      { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /projectVersions/{doc}  { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /radarLaunches/{doc}    { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /referrals/{doc}        { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /strData/{doc}          { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /supportAgentPermissions/{doc}  { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /supportAutoAssignRules/{doc}   { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /supportCSAT/{doc}              { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /supportCustomFields/{doc}      { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /supportKnowledgeBase/{doc}     { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /supportQuickResponses/{doc}    { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /supportTicketAudit/{doc}       { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /supportTickets/{doc}           { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /supportTimeEntries/{doc}       { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /supportWebhookLogs/{doc}       { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /supportWebhooks/{doc}          { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /supportWorkflowTriggers/{doc}  { allow read: if isAdmin(); allow write: if isAdmin(); }
    /* KYC verification requests carry identity documents. Read is admin-only;
       it is referenced nowhere outside src/admin/AdminPanel.jsx. */
    match /verifications/{doc}    { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /riskData/{doc}         { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /strLtrData/{doc}       { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /priceHistory/{doc}     { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /aiInsights/{doc}       { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /tabData/{doc}          { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /platformSettings/{doc} { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /marketData/{doc}       { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /devUnits/{doc}         { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /marketMetrics/{doc}    { allow read: if isAuthed(); allow write: if isAdmin(); }
    /* Almanac source entries. Ordinary clients never read this collection — they
       read the compiled tabData/almanac document, which is one read instead of
       one per entry. Read access here is admin-only because the editor needs it
       and nothing else does; keeping it closed also means an entry cannot be
       seen before it has passed the source check at compile time. */
    match /almanacEntries/{doc}   { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /transactions/{doc}     { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /invites/{token} {
      // 'get' = fetch one invite by its token (needed to open an invite link).
      // 'list' = enumerate the whole collection — that would hand anyone every
      // pending invite token, so it stays admin-only.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAuthed() && (isManager() || isAdmin());
      allow update: if isAuthed(); // Agent marks as used on join — must be signed in
      allow delete: if isAdmin();
    }

    match /legal_citations/{doc}  { allow read: if true;       allow write: if isAdmin(); }

    // ── ADMIN ONLY ───────────────────────────────────────────────
    match /adminSettings/{doc}  { allow read, write: if isAdmin(); }
    match /auditLog/{doc}       { allow read: if isAdmin(); allow create: if isAuthed(); }
    match /cronLogs/{doc}       { allow read: if isAdmin(); allow write: if false; }
    /* What the nightly sweep has already warned about, so a broker card ninety
       days from expiry is one message rather than ninety. Written only by the
       admin SDK, which bypasses these rules — the block is here so the intent is
       stated rather than left to the deny-by-default, and so the tenant audit
       sees it. */
    match /cronState/{doc}      { allow read: if isAdmin(); allow write: if false; }
    match /subscriptions/{uid}  {
      allow read: if isAuthed() && (uid() == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}